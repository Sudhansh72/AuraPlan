DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auraplan
JWT_SECRET_KEY=local-dev-secret-change-later
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
FRONTEND_ORIGIN=http://localhost:5173

# AI_PROVIDER=mock is free and local.
# AI_PROVIDER=gemini requires GEMINI_API_KEY.
# GEMINI_API_KEY must never be exposed to frontend.
# API keys must only live in backend environment variables.
AI_PROVIDER=mock
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=30
AI_FALLBACK_TO_MOCK=true

# Phase 5 Bot settings
# CHAT_PROVIDER=mock is free/local.
# CHAT_PROVIDER=gemini requires GEMINI_API_KEY.
CHAT_PROVIDER=mock

# SEARCH_PROVIDER=mock is free/local.
# SEARCH_PROVIDER=tavily requires TAVILY_API_KEY.
# SEARCH_PROVIDER=brave requires BRAVE_SEARCH_API_KEY.
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARCH_TIMEOUT_SECONDS=10
SEARCH_FALLBACK_TO_MOCK=true

# ENABLE_VENDOR_SEARCH=false disables live vendor search.
ENABLE_VENDOR_SEARCH=false
FIRECRAWL_API_KEY=

# Quota settings
MAX_TAVILY_QUOTA=1000
MAX_FIRECRAWL_QUOTA=1000
MAX_BRAVE_QUOTA=1000
MAX_DDG_QUOTA=5000